#!/bin/bash
# Generated bank datasets for one base (sm.data.build_bank_datasets --only generated): the condition 2 persona
# sets (sycophantic, humorous, terse; generated by the base under a system prompt that is stripped from the
# saved rows) and the condition 3 risky-financial-advice set, written as data/bank/<condition>/<name>__<base>.jsonl.
# The asset-backed sets are built on a CPU node first (jobs/README.md, one-time setup step 3); this job fills
# only the four generated sets, so it must run before the lora stage of that base. Generation uses the vLLM
# backend by default (GEN_BACKEND=hf for the transformers path). Idempotent: existing sets are kept unless FORCE=1.
# Submit: sbatch --dependency=afterok:<smoke job> --export=ALL,BANK=configs/bank_<base>.yaml jobs/gen_bank.sbatch
#     or: sbatch --export=ALL,BASE=<registry key> jobs/gen_bank.sbatch
# Guards: GPU pre-flight (exit 2), pinned revision, frozen code (jobs/common.sh).
# Optional env: GEN_BACKEND (vllm|hf), GEN_EXTRA_ARGS, FORCE=1, SM_PROJ.
#SBATCH --job-name=sm-gen-bank
#SBATCH --partition=gpu-short
#SBATCH --account=i.yoon
#SBATCH --gres=gpu:h200:1
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH --signal=B:TERM@60
#SBATCH --output=/projects/interpretability/shehral.m/monitors/logs/gen-bank-%j.out
#SBATCH --error=/projects/interpretability/shehral.m/monitors/logs/gen-bank-%j.err
#SBATCH --export=ALL
set -eo pipefail
SM_PROJ="${SM_PROJ:-/projects/interpretability/shehral.m/monitors}"
# shellcheck source=jobs/common.sh
source "$SM_PROJ/jobs/common.sh"
sm_install_traps
sm_log "=== sm-gen-bank start on $(hostname) ==="
sm_setup_env
sm_gpu_preflight
sm_resolve_base_key
sm_require_frozen "$BASE_KEY"
sm_require_data data/bank/MANIFEST.json

# shellcheck disable=SC2086
rc=0; sm_run "$PYTHON" -m sm.data.build_bank_datasets --config configs/bank_sources.yaml --out data/bank \
  --only generated --generate-backend "${GEN_BACKEND:-vllm}" --base "$BASE_KEY" ${FORCE:+--force} ${GEN_EXTRA_ARGS:-} || rc=$?
sm_log "=== sm-gen-bank done rc=$rc base=$BASE_KEY ==="
exit "$rc"
