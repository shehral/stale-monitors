#!/bin/bash
# Capability scores, one array task per run_id (sm.eval.capability): MMLU 500 exact match on the answer
# letter and IFEval 200 strict accuracy, scored from the battery outputs of the mmlu and ifeval batteries
# (greedy, generated by jobs/battery.sbatch with the adapter unmerged). Writes
# results/capability/<base>/<run_id>.json {"mmlu_acc", "mmlu_n", "ifeval_strict_acc", "ifeval_n", "meta"},
# which aggregate uses for the prereg Section 7 exclusion (more than 20 points below the base).
# Index map as the judge stage: 0 = the base, manifest run i at i+1 (`sm_py runs <bank> capability`).
# CPU only (scoring text, no model): partition short, no GPU pre-flight. Needs a passed V4 file (exit 2)
# and the run's mmlu/ifeval battery outputs (exit 5 when missing or still .partial).
# Idempotent: sm.eval.capability exits 0 "already done" when the JSON exists (FORCE=1 recomputes).
#
# Submit: sbatch --array=<indices>%4 --export=ALL,BANK=configs/bank_<base>.yaml jobs/capability.sbatch
# Optional env: ITEMS_DIR (default data/prompts), CAPABILITY_EXTRA_ARGS, FORCE=1,
#   ALLOW_FAILED_V4=1 (descriptive-only), SM_PROJ.
#SBATCH --job-name=sm-capability
#SBATCH --partition=short
#SBATCH --account=i.yoon
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --signal=B:TERM@60
#SBATCH --output=/projects/interpretability/shehral.m/monitors/logs/capability-%A_%a.out
#SBATCH --error=/projects/interpretability/shehral.m/monitors/logs/capability-%A_%a.err
#SBATCH --export=ALL
set -eo pipefail
SM_PROJ="${SM_PROJ:-/projects/interpretability/shehral.m/monitors}"
# shellcheck source=jobs/common.sh
source "$SM_PROJ/jobs/common.sh"
SM_GPUS_PER_JOB=0
sm_install_traps
sm_log "=== sm-capability start on $(hostname) ==="
sm_setup_cpu_env 0
[ -x "$PYTHON" ] || sm_die 2 "env python not found at $PYTHON"
sm_load_task capability
if [ "$TASK_ACTIVE" != "1" ]; then
  sm_log "SKIP: run $TASK_RUN_ID (kind $TASK_KIND) has no battery outputs to score"
  exit 0
fi
sm_require_v4 "$BASE_KEY"
sm_require_frozen "$BASE_KEY"

ITEMS_DIR="${ITEMS_DIR:-data/prompts}"
BSLUG="$("$PYTHON" -c 'import sys; from sm.eval.battery import path_slug; print(path_slug(sys.argv[1]))' "$BASE_KEY")"
BDIR="results/batteries/$BSLUG/$TASK_RUN_ID"
for b in mmlu ifeval; do
  [ -f "$BDIR/$b.jsonl" ] || sm_die 5 "battery output $BDIR/$b.jsonl missing (battery stage not finished for $TASK_RUN_ID)"
  [ ! -e "$BDIR/$b.jsonl.partial" ] || sm_die 5 "battery output $BDIR/$b.jsonl is still partial"
done

# shellcheck disable=SC2086
rc=0; sm_run "$PYTHON" -m sm.eval.capability --base "$BASE_KEY" --run-id "$TASK_RUN_ID" --batteries-root results/batteries \
  --items-dir "$ITEMS_DIR" --out results/capability ${FORCE:+--force} ${CAPABILITY_EXTRA_ARGS:-} || rc=$?
sm_log "=== sm-capability done rc=$rc run=$TASK_RUN_ID ==="
exit "$rc"
